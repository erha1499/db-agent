# Copy to .env and fill in your OpenAI-compatible endpoint, credential, and model.
# Local .env values take priority; environment values are fallbacks.
# Never commit or push .env or real credentials. This template has placeholders only.
DB_AGENT_OPENAI_BASE_URL=https://your-provider.example/v1
DB_AGENT_API_KEY=replace-with-your-api-key
DB_AGENT_MODEL=replace-with-your-model

# Positive budgets; limits: request <= 300s, run <= 600s, output <= 16384 tokens.
DB_AGENT_REQUEST_TIMEOUT_SECONDS=30
DB_AGENT_RUN_TIMEOUT_SECONDS=60
DB_AGENT_MAX_OUTPUT_TOKENS=1024
# Per-run model calls: 1-10; tool calls: 1-20.
DB_AGENT_MAX_MODEL_CALLS=4
DB_AGENT_MAX_TOOL_CALLS=6

# Local MySQL: used by Docker Compose and the Agent reader connection.
# Host, database, and user describe the fixed local setup. Change the port as needed.
DB_AGENT_MYSQL_HOST=127.0.0.1
DB_AGENT_MYSQL_PORT=13306
DB_AGENT_MYSQL_DATABASE=db_agent
DB_AGENT_MYSQL_USER=db_agent_reader
# Reader password: 24-128 letters, digits, _ or -. Set two distinct passwords locally.
DB_AGENT_MYSQL_PASSWORD=
# Docker Compose initialization only; Agent settings never use the root password.
DB_AGENT_MYSQL_ROOT_PASSWORD=
# With an existing data volume, change passwords using SQL before updating this file.

# Agent metadata access is limited to this explicit JSON array (default: no tables).
DB_AGENT_MYSQL_ALLOWED_TABLES=["customers","orders","order_items"]
# Metadata budgets: connection 1-30s, operation >0-60s, rows 1-1000, bytes 1024-131072.
DB_AGENT_MYSQL_CONNECT_TIMEOUT_SECONDS=3
DB_AGENT_MYSQL_METADATA_TIMEOUT_SECONDS=5
DB_AGENT_MYSQL_MAX_METADATA_ROWS=200
DB_AGENT_MYSQL_MAX_METADATA_BYTES=32768

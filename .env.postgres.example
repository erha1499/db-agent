# Fixed, isolated PostgreSQL fixture. setup_postgres.py --apply creates a private
# .env.postgres with random passwords when that file does not already exist.
# Never copy the admin password into the application password.
DB_AGENT_DATABASE_KIND=postgresql
DB_AGENT_POSTGRES_HOST=127.0.0.1
DB_AGENT_POSTGRES_PORT=15432
DB_AGENT_POSTGRES_DATABASE=db_agent_pg
DB_AGENT_POSTGRES_SCHEMA=business
DB_AGENT_POSTGRES_USER=db_agent_reader
DB_AGENT_POSTGRES_PASSWORD=
DB_AGENT_POSTGRES_ADMIN_PASSWORD=
DB_AGENT_POSTGRES_ALLOWED_TABLES='["customers","orders","order_items"]'
